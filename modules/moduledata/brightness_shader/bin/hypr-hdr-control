#!/usr/bin/env bash
#
# hypr-hdr-control — software HDR brightness control for Hyprland
# ---------------------------------------------------------------------------
# Drives `shader/hdr_brightness.frag` by rewriting the compile-time constants
# (`HDR_BRIGHTNESS`, `HDR_SOFTCLIP`) into a generated shader and re-applying it
# through Hyprland's `decoration:screen_shader`. Hyprland recompiles the screen
# shader whenever that keyword is set, so updates are live and need no restart.
#
# The brightness value persists in $XDG_STATE_HOME/hypr-hdr-control/brightness.
#
# Usage:
#   hypr-hdr-control up [step]      increase brightness (default step 0.1)
#   hypr-hdr-control down [step]    decrease brightness
#   hypr-hdr-control set <k>        set brightness, k in [0.05, 2.0]
#   hypr-hdr-control get            print the current value
#   hypr-hdr-control apply          (re)apply the current value (use in exec-once)
#   hypr-hdr-control on | off       enable / disable the screen shader
#   hypr-hdr-control reset          set brightness back to 1.0
#
# Environment:
#   HDR_BRIGHTNESS_TEMPLATE   path to the .frag template (auto-detected)
#   HDR_KNEE_RATIO            highlight roll-off knee, default 0.85
#   HDR_NOTIFY                set to 0 to silence notifications
#
set -euo pipefail

readonly MIN_BRIGHTNESS="0.05"
readonly MAX_BRIGHTNESS="2.0"
readonly DEFAULT_STEP="0.1"
readonly DEFAULT_KNEE="${HDR_KNEE_RATIO:-0.85}"

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" >/dev/null 2>&1 && pwd)"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/hypr-hdr-control"
STATE_FILE="$STATE_DIR/brightness"
SHADER_OUT="$STATE_DIR/hdr_brightness.frag"

# --- helpers ---------------------------------------------------------------

log() { printf '%s\n' "$*" >&2; }

notify() {
    [[ "${HDR_NOTIFY:-1}" == "1" ]] || return 0
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -a "HDR Brightness" -h string:x-canonical-private-synchronous:hdr-brightness \
        -t 1200 "HDR brightness" "$1" || true
}

hypr_running() {
    [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || return 1
    command -v hyprctl >/dev/null 2>&1 || return 1
    hyprctl version >/dev/null 2>&1
}

find_template() {
    local candidates=()
    [[ -n "${HDR_BRIGHTNESS_TEMPLATE:-}" ]] && candidates+=("$HDR_BRIGHTNESS_TEMPLATE")
    candidates+=(
        "$SCRIPT_DIR/../shader/hdr_brightness.frag"
        "$SCRIPT_DIR/shader/hdr_brightness.frag"
        "$SCRIPT_DIR/hdr_brightness.frag"
        "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/shaders/hdr_brightness.frag"
    )
    local c
    for c in "${candidates[@]}"; do
        if [[ -f "$c" ]]; then
            printf '%s\n' "$c"
            return 0
        fi
    done
    return 1
}

# Float helpers (bash has no floating point).
clamp() { awk -v v="$1" -v lo="$MIN_BRIGHTNESS" -v hi="$MAX_BRIGHTNESS" 'BEGIN { if (v < lo) v = lo; if (v > hi) v = hi; printf "%.3f", v }'; }
add() { awk -v a="$1" -v b="$2" 'BEGIN { printf "%.3f", a + b }'; }
validate_num() { [[ "$1" =~ ^[0-9]+([.][0-9]+)?$ ]]; }

read_state() {
    if [[ -f "$STATE_FILE" ]]; then
        cat "$STATE_FILE"
    else
        printf '1.000\n'
    fi
}

write_state() {
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$1" >"$STATE_FILE"
}

# Regenerate the shader from the template with the given value baked in.
generate_shader() {
    local k="$1" softclip
    softclip="$(awk -v v="$k" 'BEGIN { print (v > 1.0) ? 1 : 0 }')"

    local template
    if ! template="$(find_template)"; then
        log "hypr-hdr-control: could not locate hdr_brightness.frag template."
        log "Set HDR_BRIGHTNESS_TEMPLATE to its path."
        return 1
    fi

    mkdir -p "$STATE_DIR"
    local tmp
    tmp="$(mktemp "$STATE_DIR/.hdr_brightness.XXXXXX")"
    sed -E \
        -e "s|^#define HDR_BRIGHTNESS[[:space:]].*|#define HDR_BRIGHTNESS ${k}   // k in [0.05, 2.0]|" \
        -e "s|^#define HDR_SOFTCLIP[[:space:]].*|#define HDR_SOFTCLIP   ${softclip}     // 1 while k > 1.0, else 0|" \
        -e "s|^#define HDR_KNEE_RATIO[[:space:]].*|#define HDR_KNEE_RATIO ${DEFAULT_KNEE}  // top fraction where roll-off starts|" \
        "$template" >"$tmp"
    mv -f "$tmp" "$SHADER_OUT"   # atomic: Hyprland never reads a partial file
}

apply_shader() {
    if [[ ! -f "$SHADER_OUT" ]]; then
        generate_shader "$(read_state)"
    fi
    if ! hypr_running; then
        log "hypr-hdr-control: Hyprland is not running; value saved only."
        return 0
    fi
    # Setting this keyword always trips REFRESH_SCREEN_SHADER in Hyprland,
    # which recompiles the shader on the next frame.
    hyprctl keyword decoration:screen_shader "$SHADER_OUT" >/dev/null
}

clear_shader() {
    hypr_running || return 0
    hyprctl keyword decoration:screen_shader "" >/dev/null || true
}

# --- commands --------------------------------------------------------------

cmd_set() {
    local raw="${1:-}"
    [[ -n "$raw" ]] || { log "usage: hypr-hdr-control set <0.05..2.0>"; return 2; }
    validate_num "$raw" || { log "invalid number: $raw"; return 2; }
    local k
    k="$(clamp "$raw")"
    write_state "$k"
    generate_shader "$k"
    apply_shader
    notify "${k}x"
}

cmd_up() {
    local step="${1:-$DEFAULT_STEP}" k
    validate_num "$step" || { log "invalid step: $step"; return 2; }
    k="$(clamp "$(add "$(read_state)" "$step")")"
    write_state "$k"
    generate_shader "$k"
    apply_shader
    notify "${k}x"
}

cmd_down() {
    local step="${1:-$DEFAULT_STEP}" k
    validate_num "$step" || { log "invalid step: $step"; return 2; }
    k="$(clamp "$(add "$(read_state)" "-${step}")")"
    write_state "$k"
    generate_shader "$k"
    apply_shader
    notify "${k}x"
}

cmd_get() { read_state; }

cmd_reset() { cmd_set "1.0"; }

cmd_on() { apply_shader; notify "on ($(read_state)x)"; }

cmd_off() {
    clear_shader
    notify "off"
}

cmd_apply() {
    generate_shader "$(read_state)"
    apply_shader
}

cmd_status() {
    local state="active"
    if ! hypr_running; then
        state="inactive (no Hyprland)"
    else
        local cur
        cur="$(hyprctl getoption decoration:screen_shader 2>/dev/null | awk -F': ' '/^str:/ {print $2}')"
        [[ -n "$cur" && "$cur" != "[[EMPTY]]" ]] || state="inactive"
    fi
    printf 'brightness=%s shader=%s\n' "$(read_state)" "$state"
}

cmd_help() { sed -n '3,30p' "$0"; }

main() {
    local cmd="${1:-get}"
    shift || true
    case "$cmd" in
        up) cmd_up "$@" ;;
        down) cmd_down "$@" ;;
        set) cmd_set "$@" ;;
        get | value) cmd_get ;;
        reset | default) cmd_reset ;;
        apply | refresh) cmd_apply ;;
        on) cmd_on ;;
        off | disable) cmd_off ;;
        status) cmd_status ;;
        help | -h | --help) cmd_help ;;
        *) log "unknown command: $cmd"; cmd_help; return 2 ;;
    esac
}

main "$@"
