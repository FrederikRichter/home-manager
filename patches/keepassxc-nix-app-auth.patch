+void TestFdoSecrets::testNixAppAuth()
+{
+    using FdoSecrets::DBusClient;
+    using FdoSecrets::DBusMgr;
+    using FdoSecrets::PeerInfo;
+    using FdoSecrets::ProcInfo;
+
+    // 1. Test Nix store path normalization across store hash and version changes
+    const auto mailspringV1 = DBusMgr::normalizeNixStorePath(
+        QStringLiteral("/nix/store/mxj168gkxnriq7mkh8yp8d57f5265c8d-mailspring-1.26.0/share/mailspring/resources/app.asar"));
+    const auto mailspringV2 = DBusMgr::normalizeNixStorePath(
+        QStringLiteral("/nix/store/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-mailspring-1.27.1/share/mailspring/resources/app.asar"));
+    QCOMPARE(mailspringV1, QStringLiteral("nix:mailspring:/share/mailspring/resources/app.asar"));
+    QCOMPARE(mailspringV1, mailspringV2);
+
+    const auto heliumAppId = DBusMgr::normalizeNixStorePath(
+        QStringLiteral("/nix/store/929h66r24xfy7k0mkckg7k2yh6kci9vm-helium-0.20.3.1/opt/helium/helium"));
+    QCOMPARE(heliumAppId, QStringLiteral("nix:helium:/opt/helium/helium"));
+
+    const auto agyAppId = DBusMgr::normalizeNixStorePath(
+        QStringLiteral("/nix/store/8m9r9793a32w46078x49y426w913c7v0-antigravity-cli-1.4.8/bin/agy"));
+    QCOMPARE(agyAppId, QStringLiteral("nix:antigravity-cli:/bin/agy"));
+
+    const auto secretToolPath =
+        QStringLiteral("/nix/store/b0p95w35kbs29k3j0p8f03z0v3k3m58p-libsecret-0.25.7/bin/secret-tool");
+    const auto secretToolAppId = DBusMgr::normalizeNixStorePath(secretToolPath);
+    QCOMPARE(secretToolAppId, QStringLiteral("nix:libsecret:/bin/secret-tool"));
+
+    // 2. Test trusted vs untrusted CLI classification & Electron .asar resolution
+    {
+        PeerInfo electronPeer{
+            QStringLiteral(":1.50"),
+            0,
+            true,
+            {ProcInfo{
+                0,
+                1,
+                QStringLiteral("/nix/store/rs2nyh0mmp8hc73hr0v04jsdsfjncf58-electron-unwrapped-44.9.3/libexec/electron/electron"),
+                QStringLiteral("electron"),
+                QStringLiteral("/nix/store/rs2nyh0mmp8hc73hr0v04jsdsfjncf58-electron-unwrapped-44.9.3/libexec/electron/electron --password-store=gnome-libsecret /nix/store/mxj168gkxnriq7mkh8yp8d57f5265c8d-mailspring-1.26.0/share/mailspring/resources/app.asar"),
+            }},
+            {},
+            false,
+        };
+        DBusMgr::resolveProcessIdentity(
+            electronPeer.pid, electronPeer.hierarchy, electronPeer.appId, electronPeer.untrustedCli);
+        QCOMPARE(electronPeer.appId, QStringLiteral("nix:mailspring:/share/mailspring/resources/app.asar"));
+        QVERIFY(!electronPeer.untrustedCli);
+        QCOMPARE(electronPeer.hierarchy.front().name, QStringLiteral("mailspring"));
+    }
+
+    QVERIFY(!DBusMgr::isUntrustedCliExecutable(
+        QStringLiteral("/nix/store/mxj168gkxnriq7mkh8yp8d57f5265c8d-mailspring-1.26.0/share/mailspring/resources/app.asar"),
+        mailspringV1));
+    QVERIFY(!DBusMgr::isUntrustedCliExecutable(
+        QStringLiteral("/nix/store/929h66r24xfy7k0mkckg7k2yh6kci9vm-helium-0.20.3.1/opt/helium/helium"),
+        heliumAppId));
+    QVERIFY(DBusMgr::isUntrustedCliExecutable(secretToolPath, secretToolAppId));
+    QVERIFY(DBusMgr::isUntrustedCliExecutable(QStringLiteral("/tmp/evil-binary"), QString{}));
+
+    // 3. Test remembering authorizations across short-lived processes & disconnect
+    FdoSecrets::settings()->setConfirmAccessItem(true);
+    DBusMgr dbus;
+    const auto itemUuid = QUuid::createUuid();
+    const auto otherUuid = QUuid::createUuid();
+
+    {
+        PeerInfo peer1{
+            QStringLiteral(":1.101"),
+            1001,
+            true,
+            {ProcInfo{1001, 1, QStringLiteral("/nix/store/8m9r9793a32w46078x49y426w913c7v0-antigravity-cli-1.4.8/bin/agy"), QStringLiteral("agy"), QStringLiteral("agy")}},
+            agyAppId,
+            false,
+        };
+        DBusClient client1(&dbus, peer1);
+        QVERIFY(!client1.itemAuthorized(itemUuid));
+        client1.setItemAuthorized(itemUuid, AuthDecision::Allowed);
+        QVERIFY(client1.itemAuthorized(itemUuid));
+        // Disconnect short-lived process: remembered auth for appId must survive
+        client1.disconnectDBus();
+    }
+
+    {
+        // Second invocation with new D-Bus address, new PID, and upgraded Nix store path
+        PeerInfo peer2{
+            QStringLiteral(":1.205"),
+            2042,
+            true,
+            {ProcInfo{2042, 1, QStringLiteral("/nix/store/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb-antigravity-cli-1.5.0/bin/agy"), QStringLiteral("agy"), QStringLiteral("agy")}},
+            agyAppId,
+            false,
+        };
+        DBusClient client2(&dbus, peer2);
+        QVERIFY(client2.itemAuthorized(itemUuid));
+        QVERIFY(!client2.itemAuthorized(otherUuid));
+    }
+
+    // 4. Test untrusted CLI (secret-tool) downgrades Allowed -> AllowedOnce
+    {
+        PeerInfo stPeer{
+            QStringLiteral(":1.300"),
+            3001,
+            true,
+            {ProcInfo{3001, 1, secretToolPath, QStringLiteral("secret-tool"), secretToolPath}},
+            secretToolAppId,
+            true,
+        };
+        DBusClient stClient(&dbus, stPeer);
+        stClient.setItemAuthorized(itemUuid, AuthDecision::Allowed);
+        // First access consumes AllowedOnce
+        QVERIFY(stClient.itemAuthorizedResetOnce(itemUuid));
+        // Subsequent access is locked again
+        QVERIFY(!stClient.itemAuthorized(itemUuid));
+    }
+}
