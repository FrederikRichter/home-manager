+    namespace
+    {
+        bool hasUntrustedEnv(uint pid)
+        {
+            if (pid == 0) {
+                return false;
+            }
+            QFile envFile(QStringLiteral("/proc/%1/environ").arg(pid));
+            if (!envFile.open(QIODevice::ReadOnly)) {
+                return true;
+            }
+            const auto entries = envFile.readAll().split('\0');
+            static const QStringList dangerousPrefixes = {
+                QStringLiteral("LD_PRELOAD="),
+                QStringLiteral("LD_AUDIT="),
+                QStringLiteral("ELECTRON_RUN_AS_NODE="),
+                QStringLiteral("NODE_OPTIONS="),
+                QStringLiteral("PYTHONINSPECT="),
+                QStringLiteral("PYTHONSTARTUP="),
+                QStringLiteral("PYTHONPATH="),
+                QStringLiteral("PERL5OPT="),
+                QStringLiteral("RUBYOPT="),
+            };
+            for (const auto& rawEntry : entries) {
+                if (rawEntry.isEmpty()) {
+                    continue;
+                }
+                const auto entry = QString::fromLocal8Bit(rawEntry);
+                for (const auto& prefix : dangerousPrefixes) {
+                    if (entry.startsWith(prefix) && entry.size() > prefix.size()) {
+                        return true;
+                    }
+                }
+            }
+            return false;
+        }
+
+        bool hasUntrustedCmdline(const QString& command)
+        {
+            static const QRegularExpression dangerousFlagsRe(QStringLiteral(
+                R"((?:^|\s)--(?:inspect|remote-debugging-|gpu-launcher|renderer-cmd-prefix|utility-cmd-prefix|ppapi-plugin-launcher|browser-subprocess-path)\b)"));
+            return dangerousFlagsRe.match(command).hasMatch();
+        }
+
+        QString resolveElectronAsarPath(uint pid, const QString& exePath, const QString& command)
+        {
+            const auto baseName = QFileInfo(exePath).fileName();
+            if (baseName != QStringLiteral("electron") && !baseName.startsWith(QStringLiteral(".electron"))) {
+                return {};
+            }
+            if (pid > 0) {
+                QDir fdDir(QStringLiteral("/proc/%1/fd").arg(pid));
+                const auto fdEntries =
+                    fdDir.entryInfoList(QDir::Dirs | QDir::Files | QDir::System | QDir::NoDotAndDotDot);
+                for (const auto& fdInfo : fdEntries) {
+                    const auto target = fdInfo.symLinkTarget();
+                    if (target.startsWith(QStringLiteral("/nix/store/")) && target.endsWith(QStringLiteral(".asar"))
+                        && !target.endsWith(QStringLiteral("/default_app.asar")) && command.contains(target)) {
+                        const auto canonical = QFileInfo(target).canonicalFilePath();
+                        if (canonical.startsWith(QStringLiteral("/nix/store/"))
+                            && canonical.endsWith(QStringLiteral(".asar"))) {
+                            return canonical;
+                        }
+                    }
+                }
+            }
+            static const QRegularExpression cmdAsarRe(
+                QStringLiteral(R"((/nix/store/[a-z0-9]{32}-[^/\s]+/\S+?\.asar)\b)"));
+            auto it = cmdAsarRe.globalMatch(command);
+            while (it.hasNext()) {
+                const auto match = it.next();
+                const auto candidate = match.captured(1);
+                if (!candidate.endsWith(QStringLiteral("/default_app.asar"))) {
+                    const auto canonical =
+                        (pid == 0) ? QDir::cleanPath(candidate) : QFileInfo(candidate).canonicalFilePath();
+                    if (canonical.startsWith(QStringLiteral("/nix/store/"))
+                        && canonical.endsWith(QStringLiteral(".asar"))) {
+                        return canonical;
+                    }
+                }
+            }
+            return {};
+        }
+    } // namespace
+
+    void DBusMgr::resolveProcessIdentity(uint pid, QList<ProcInfo>& hierarchy, QString& appId, bool& untrustedCli)
+    {
+        if (hierarchy.isEmpty()) {
+            appId.clear();
+            untrustedCli = true;
+            return;
+        }
+        auto& front = hierarchy.front();
+        const bool badEnv = hasUntrustedEnv(pid);
+        const bool badCmd = hasUntrustedCmdline(front.command);
+        if (!badEnv && !badCmd) {
+            for (const auto& proc : asConst(hierarchy)) {
+                const auto asarPath = resolveElectronAsarPath(proc.pid, proc.exePath, proc.command);
+                if (!asarPath.isEmpty()) {
+                    front.exePath = asarPath;
+                    static const QRegularExpression nixPkgRe(
+                        QStringLiteral(R"(^/nix/store/[a-z0-9]{32}-([a-zA-Z0-9._+-]+?)(?:-[0-9][^/]*)?/)"));
+                    const auto pkgMatch = nixPkgRe.match(asarPath);
+                    if (pkgMatch.hasMatch()) {
+                        front.name = pkgMatch.captured(1);
+                    }
+                    break;
+                }
+            }
+        }
+        appId = normalizeNixStorePath(front.exePath);
+        untrustedCli = badEnv || badCmd || isUntrustedCliExecutable(front.exePath, appId);
+    }
+
+    QString DBusMgr::normalizeNixStorePath(const QString& path)
+    {
+        static const QRegularExpression nixStoreRe(
+            QStringLiteral(R"(^/nix/store/[a-z0-9]{32}-([a-zA-Z0-9._+-]+?)(?:-[0-9][^/]*)?(/.*)$)"));
+        const auto match = nixStoreRe.match(path);
+        if (!match.hasMatch()) {
+            return {};
+        }
+        return QStringLiteral("nix:%1:%2").arg(match.captured(1), match.captured(2));
+    }
+
+    bool DBusMgr::isUntrustedCliExecutable(const QString& exePath, const QString& appId)
+    {
+        if (appId.isEmpty()) {
+            return true;
+        }
+        const auto baseName = QFileInfo(exePath).fileName();
+        static const QSet<QString> untrustedNames = {
+            QStringLiteral("secret-tool"),
+            QStringLiteral("busctl"),
+            QStringLiteral("gdbus"),
+            QStringLiteral("qdbus"),
+            QStringLiteral("qdbus6"),
+            QStringLiteral("dbus-send"),
+            QStringLiteral("bash"),
+            QStringLiteral("sh"),
+            QStringLiteral("zsh"),
+            QStringLiteral("fish"),
+            QStringLiteral("dash"),
+            QStringLiteral("ksh"),
+            QStringLiteral("tcsh"),
+            QStringLiteral("nu"),
+            QStringLiteral("python"),
+            QStringLiteral("python2"),
+            QStringLiteral("python3"),
+            QStringLiteral("node"),
+            QStringLiteral("nodejs"),
+            QStringLiteral("deno"),
+            QStringLiteral("bun"),
+            QStringLiteral("perl"),
+            QStringLiteral("ruby"),
+            QStringLiteral("lua"),
+            QStringLiteral("luajit"),
+            QStringLiteral("php"),
+            QStringLiteral("tclsh"),
+            QStringLiteral("awk"),
+            QStringLiteral("gawk"),
+            QStringLiteral("electron"),
+            QStringLiteral(".electron-wrapped"),
+            QStringLiteral("flatpak-spawn"),
+            QStringLiteral("bwrap"),
+            QStringLiteral("env"),
+            QStringLiteral("xargs"),
+            QStringLiteral("sudo"),
+            QStringLiteral("pkexec"),
+        };
+        if (untrustedNames.contains(baseName) || baseName.startsWith(QStringLiteral("python3."))
+            || baseName.startsWith(QStringLiteral("python2.")) || baseName.startsWith(QStringLiteral("perl5."))) {
+            return true;
+        }
+        return false;
+    }
