+
+    void DBusMgr::setAppItemAuthorized(const QString& appId, const QUuid& uuid, AuthDecision auth)
+    {
+        if (appId.isEmpty()) {
+            return;
+        }
+        auto& state = m_appAuth[appId];
+        state.allowed.remove(uuid);
+        state.denied.remove(uuid);
+        if (auth == AuthDecision::Allowed) {
+            state.allowed.insert(uuid);
+        } else if (auth == AuthDecision::Denied) {
+            state.denied.insert(uuid);
+        }
+        if (state.isEmpty()) {
+            m_appAuth.remove(appId);
+        }
+
+        for (const auto& client : asConst(m_clients)) {
+            if (client && client->appId() == appId) {
+                client->m_allowed = state.allowed;
+                client->m_denied = state.denied;
+            }
+        }
+
+        syncRememberedClient(appId);
+        saveDatabaseAuth();
+        emit appAuthChanged(appId);
+    }
+
+    void DBusMgr::setAppAllAuthorized(const QString& appId, AuthDecision auth)
+    {
+        if (appId.isEmpty()) {
+            return;
+        }
+        auto& state = m_appAuth[appId];
+        state.authorizedAll = auth;
+        if (state.isEmpty()) {
+            m_appAuth.remove(appId);
+        }
+
+        for (const auto& client : asConst(m_clients)) {
+            if (client && client->appId() == appId) {
+                client->m_authorizedAll = state.authorizedAll;
+            }
+        }
+
+        syncRememberedClient(appId);
+        saveDatabaseAuth();
+        emit appAuthChanged(appId);
+    }
+
+    void DBusMgr::clearAppAuthorization(const QString& appId)
+    {
+        if (appId.isEmpty()) {
+            return;
+        }
+        m_appAuth.remove(appId);
+
+        for (const auto& client : asConst(m_clients)) {
+            if (client && client->appId() == appId) {
+                client->m_authorizedAll = AuthDecision::Undecided;
+                client->m_allowed.clear();
+                client->m_denied.clear();
+            }
+        }
+
+        syncRememberedClient(appId);
+        saveDatabaseAuth();
+    }
+
+    void DBusMgr::syncRememberedClient(const QString& appId)
+    {
+        if (appId.isEmpty()) {
+            return;
+        }
+        const auto remKey = QStringLiteral("remembered:") + appId;
+        const auto state = m_appAuth.value(appId);
+        if (state.isEmpty()) {
+            auto it = m_clients.find(remKey);
+            if (it != m_clients.end()) {
+                auto remClient = it.value();
+                m_clients.erase(it);
+                emit clientDisconnected(remClient);
+            }
+            return;
+        }
+
+        for (auto it = m_clients.constBegin(); it != m_clients.constEnd(); ++it) {
+            if (it.key() != remKey && it.value() && it.value()->appId() == appId) {
+                // Active connection already present for this appId
+                return;
+            }
+        }
+
+        if (!m_clients.contains(remKey)) {
+            PeerInfo info{
+                remKey,
+                0,
+                true,
+                {ProcInfo{0, 0, appId, appId, appId}},
+                appId,
+                false,
+            };
+            auto remClient = DBusClientPtr(new DBusClient(this, info));
+            m_clients.insert(remKey, remClient);
+            emit clientConnected(remClient);
+        }
+    }
+
+    void DBusMgr::loadDatabaseAuth(Database* db)
+    {
+        if (!db || !db->metadata() || !db->metadata()->customData()) {
+            return;
+        }
+        const auto raw = db->metadata()->customData()->value(CustomData::FdoSecretsAppAuth);
+        if (raw.isEmpty()) {
+            return;
+        }
+        const auto doc = QJsonDocument::fromJson(raw.toUtf8());
+        if (!doc.isObject()) {
+            return;
+        }
+        const auto root = doc.object();
+        for (auto it = root.constBegin(); it != root.constEnd(); ++it) {
+            const auto appId = it.key();
+            if (appId.isEmpty() || !it.value().isObject()) {
+                continue;
+            }
+            const auto obj = it.value().toObject();
+            auto& state = m_appAuth[appId];
+            const auto authAllStr = obj.value(QStringLiteral("authorizedAll")).toString();
+            if (authAllStr == QStringLiteral("Allowed")) {
+                state.authorizedAll = AuthDecision::Allowed;
+            } else if (authAllStr == QStringLiteral("Denied")) {
+                state.authorizedAll = AuthDecision::Denied;
+            }
+            for (const auto& val : obj.value(QStringLiteral("allowed")).toArray()) {
+                const QUuid u(val.toString());
+                if (!u.isNull()) {
+                    state.allowed.insert(u);
+                }
+            }
+            for (const auto& val : obj.value(QStringLiteral("denied")).toArray()) {
+                const QUuid u(val.toString());
+                if (!u.isNull()) {
+                    state.denied.insert(u);
+                }
+            }
+            if (state.isEmpty()) {
+                m_appAuth.remove(appId);
+            } else {
+                for (const auto& client : asConst(m_clients)) {
+                    if (client && client->appId() == appId) {
+                        client->m_authorizedAll = state.authorizedAll;
+                        client->m_allowed = state.allowed;
+                        client->m_denied = state.denied;
+                    }
+                }
+                syncRememberedClient(appId);
+            }
+        }
+    }
+
+    void DBusMgr::saveDatabaseAuth()
+    {
+        QJsonObject root;
+        for (auto it = m_appAuth.constBegin(); it != m_appAuth.constEnd(); ++it) {
+            if (it.value().isEmpty()) {
+                continue;
+            }
+            QJsonObject obj;
+            QString authAllStr = QStringLiteral("Undecided");
+            if (it.value().authorizedAll == AuthDecision::Allowed) {
+                authAllStr = QStringLiteral("Allowed");
+            } else if (it.value().authorizedAll == AuthDecision::Denied) {
+                authAllStr = QStringLiteral("Denied");
+            }
+            obj.insert(QStringLiteral("authorizedAll"), authAllStr);
+
+            QJsonArray allowedArr;
+            for (const auto& u : it.value().allowed) {
+                allowedArr.append(u.toString());
+            }
+            obj.insert(QStringLiteral("allowed"), allowedArr);
+
+            QJsonArray deniedArr;
+            for (const auto& u : it.value().denied) {
+                deniedArr.append(u.toString());
+            }
+            obj.insert(QStringLiteral("denied"), deniedArr);
+
+            root.insert(it.key(), obj);
+        }
+
+        const auto serialized = QString::fromUtf8(QJsonDocument(root).toJson(QJsonDocument::Compact));
+
+        QSet<Database*> updatedDbs;
+        for (const auto& obj : asConst(m_objects)) {
+            auto coll = qobject_cast<Collection*>(obj);
+            if (!coll || !coll->backend() || coll->backend()->isLocked()) {
+                continue;
+            }
+            auto db = coll->backend()->database();
+            if (!db || updatedDbs.contains(db.data())) {
+                continue;
+            }
+            updatedDbs.insert(db.data());
+            {
+                QSignalBlocker blocker(db->metadata()->customData());
+                if (root.isEmpty()) {
+                    db->metadata()->customData()->remove(CustomData::FdoSecretsAppAuth);
+                } else {
+                    db->metadata()->customData()->set(CustomData::FdoSecretsAppAuth, serialized);
+                }
+            }
+            if (config()->get(Config::AutoSaveAfterEveryChange).toBool() && !db->filePath().isEmpty()) {
+                coll->backend()->save();
+            }
+        }
     }
 
     void DBusMgr::dbusServiceUnregistered(const QString& service)
